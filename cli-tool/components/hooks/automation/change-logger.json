{
  "description": "Log every file mutation to CSV for demo prep. Records timestamp, tool, file path, action, and details for Edit, MultiEdit, Write, and Bash operations. Output: .gemini/critical_log_changes.csv",
  "supportingFiles": [
    {
      "source": "change-logger.py",
      "destination": ".gemini/hooks/change-logger.py",
      "executable": true
    }
  ],
  "hooks": {
    "AfterTool": [
      {
        "matcher": "replace",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .gemini/hooks/change-logger.py"
          }
        ]
      },
      {
        "matcher": "write_file",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .gemini/hooks/change-logger.py"
          }
        ]
      },
      {
        "matcher": "replace",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .gemini/hooks/change-logger.py"
          }
        ]
      },
      {
        "matcher": "run_shell_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .gemini/hooks/change-logger.py"
          }
        ]
      }
    ]
  }
}
